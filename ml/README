###inference
$ python cnn_lstm_prewindow_spike_infer_eval_final.py --csv ../data/temperature_2020_2024.csv --model ./assets_cnn_lstm_keyday/cnn_lstm_keyday.pth --out_dir ./assets_cnn_lstm_keyday_eval_final --event_col synthetic_event --seq_len 60 --horizon_days 10 --alpha 10 --cal_w 90 --q_base 0.995 --q_spike 0.99 --z_delta_thr 1.7

